{
  "name": "ebt-presents-corner-store-dash",
  "version": "1.0.0",
  "private": true,
  "description": "EBT Presents: Corner Store Dash \u2014 grab the list, dodge the bully, clear checkout.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs 5173",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute ebt-leaderboard --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute ebt-leaderboard --remote --file=./schema.sql",
    "db:top": "wrangler d1 execute ebt-leaderboard --remote --command \"SELECT name, score FROM scores ORDER BY score DESC LIMIT 10\"",
    "qa": "node tests/qa.mjs",
    "build:standalone": "node standalone/build.mjs",
    "lighthouse": "npx --yes lighthouse http://localhost:5173 --preset=desktop --only-categories=performance,accessibility,best-practices,seo --output=html --output-path=./lighthouse-report.html"
  },
  "devDependencies": {
    "puppeteer": "^23.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
